# Copy to .env.local for development, or to /etc/cardynasty/app.env on the server.
# Never commit real values.

# Public address of the site (used in emails, sitemap, canonical links)
SITE_URL=https://cardynasty.example.com

# Where the SQLite database lives. Server: /var/lib/cardynasty
DATA_DIR=./data

# Number of reverse proxies in front of the app that append X-Forwarded-For.
# 1 = Caddy/nginx on the same server. 2 = CloudFront → Caddy.
TRUSTED_PROXY_HOPS=1

# Where new-enquiry alerts go (falls back to the site's contact email)
NOTIFY_EMAIL=owner@example.com

# Outgoing mail: EITHER Resend…
# RESEND_API_KEY=
# …OR SMTP (e.g. Amazon SES SMTP credentials)
MAIL_FROM="Car Dynasty <no-reply@cardynasty.example.com>"
# SMTP_HOST=email-smtp.<region>.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Server only: S3 bucket for nightly database backups
# BACKUP_BUCKET=cardynasty-backups-<random-suffix>

# Optional: channel used by `npm run youtube:sync`
# YOUTUBE_HANDLE=CARDYNASTY
